# ============================================
# AffiMark Backend - Configuration Template
# ============================================
# Copy this to .env.local and fill in your values
# IMPORTANT: Never commit .env.local to git

# ===== CORE (Required) =====
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

BACKEND_API_KEY=your_backend_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# ===== DATAFEEDR (Required for Product Finder) =====
DATAFEEDR_ACCESS_ID=your_datafeedr_access_id
DATAFEEDR_SECRET_KEY=your_datafeedr_secret_key

# ===== AMAZON (Optional - product enrichment) =====
RAINFOREST_API_KEY=your_rainforest_api_key
KEEPA_API_KEY=your_keepa_api_key
AMAZON_ASSOCIATES_TAG=your_amazon_tag_here

# ===== SEARCH (Optional) =====
SERPAPI_KEY=your_serpapi_key_here

# ===== AFFILIATE NETWORKS (Optional) =====
IMPACT_ACCOUNT_SID=your_impact_account_sid
IMPACT_AUTH_TOKEN=your_impact_auth_token

# ===== SOCIAL MEDIA OAUTH =====
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
